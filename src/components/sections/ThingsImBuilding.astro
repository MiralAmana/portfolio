---
import { getCollection } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import { homePath, loc, t, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const s = t(lang).building;
const labHref = `${homePath(lang)}#lab`;

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<section
  id="building"
  class="px-6 sm:px-10 py-28 lg:py-36 border-t border-line"
  aria-labelledby="building-title"
>
  <div class="max-w-6xl mx-auto">
    <SectionHeading id="building-title" eyebrow={s.eyebrow} title={s.title} intro={s.intro} />

    <ul class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((p, i) => (
          <li class="reveal" style={`--rd: ${i * 0.08}s`}>
            <button
              type="button"
              data-open={`dialog-${p.id}`}
              class="project-card glass group relative block h-full w-full cursor-pointer overflow-hidden rounded-3xl p-7 text-left transition-colors duration-300 hover:border-white/20 focus-visible:outline-2 focus-visible:outline-accent"
            >
              <span class="spot pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true" />
              <span class="relative block label-mono">{loc(p.data, 'kind', lang)}</span>
              <span class="relative mt-5 block font-display text-3xl font-light leading-tight text-ink">
                {p.data.name}
              </span>
              <span class="relative mt-3 block text-muted leading-relaxed">{loc(p.data, 'tagline', lang)}</span>
              <span class="relative mt-8 flex flex-wrap gap-2">
                {p.data.tech.slice(0, 4).map((t) => (
                  <span class="rounded-full border border-line px-3 py-1 font-mono text-[10.5px] tracking-wide text-muted">
                    {t}
                  </span>
                ))}
              </span>
              <span class="relative mt-8 inline-flex items-center gap-2 label-mono transition-colors group-hover:text-ink">
                {s.view} <span aria-hidden="true">→</span>
              </span>
            </button>
          </li>
        ))
      }

      <li class="reveal" style={`--rd: ${projects.length * 0.08}s`}>
        <div class="h-full rounded-3xl border border-dashed border-line p-7">
          <p class="label-mono">{s.experiments}</p>
          <p class="mt-5 font-display text-2xl font-light text-ink/80">{s.experimentsText}</p>
          <a href={labHref} class="mt-8 inline-flex items-center gap-2 label-mono hover:text-ink transition-colors">
            {s.openLab} <span aria-hidden="true">→</span>
          </a>
        </div>
      </li>
    </ul>
  </div>

  {
    projects.map((p) => (
      <dialog
        id={`dialog-${p.id}`}
        aria-labelledby={`title-${p.id}`}
        class="project-dialog m-auto w-[calc(100%-2rem)] max-w-3xl max-h-[88dvh] overflow-y-auto rounded-3xl border border-line bg-[rgba(12,12,14,0.94)] p-0 text-ink shadow-glass backdrop:bg-black/70 backdrop:backdrop-blur-sm"
      >
        <div class="relative p-7 sm:p-10">
          <form method="dialog" class="absolute right-5 top-5">
            <button
              aria-label={t(lang).common.close}
              class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-line text-muted transition-colors hover:text-ink hover:border-white/25"
            >
              <span aria-hidden="true">✕</span>
            </button>
          </form>

          <p class="label-mono">{loc(p.data, 'kind', lang)}</p>
          <h3 id={`title-${p.id}`} class="mt-4 pr-12 font-display text-4xl font-light text-ink">
            {p.data.name}
          </h3>
          <p class="mt-3 text-lg text-muted">{loc(p.data, 'tagline', lang)}</p>
          <p class="mt-6 leading-relaxed text-ink/85">{loc(p.data, 'description', lang)}</p>

          <div class="mt-10 grid gap-8 sm:grid-cols-2">
            {p.data.problem && (
              <div>
                <p class="label-mono text-accent">{s.problem}</p>
                <p class="mt-3 leading-relaxed text-muted">{loc(p.data, 'problem', lang)}</p>
              </div>
            )}
            {p.data.solution && (
              <div>
                <p class="label-mono text-accent">{s.solution}</p>
                <p class="mt-3 leading-relaxed text-muted">{loc(p.data, 'solution', lang)}</p>
              </div>
            )}
          </div>

          <div class="mt-10">
            <p class="label-mono">{s.builtWith}</p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {p.data.tech.map((t) => (
                <li class="rounded-full border border-line px-3 py-1 font-mono text-[11px] tracking-wide text-ink/80">
                  {t}
                </li>
              ))}
            </ul>
          </div>

          {p.data.video && (
            <div class="mt-10">
              <p class="label-mono">{s.demo}</p>
              <video
                controls
                muted
                playsinline
                preload="none"
                poster={p.data.screenshots[0]}
                aria-label={s.videoLabel(p.data.name)}
                class="mt-3 aspect-video w-full rounded-2xl border border-line bg-black"
              >
                <source src={p.data.video} type="video/mp4" />
              </video>
            </div>
          )}

          <div class="mt-10">
            <p class="label-mono">{s.screenshots}</p>
            {p.data.screenshots.length > 0 ? (
              <div class="mt-3 grid gap-3 sm:grid-cols-2">
                {p.data.screenshots.map((src, i) => (
                  <img
                    src={src}
                    alt={s.shotAlt(p.data.name, i + 1)}
                    width="1600"
                    loading="lazy"
                    decoding="async"
                    class:list={['h-auto w-full rounded-2xl border border-line', i === 0 && 'sm:col-span-2']}
                  />
                ))}
              </div>
            ) : (
              <div class="mt-3 flex h-32 items-center justify-center rounded-2xl border border-dashed border-line">
                <span class="label-mono">{s.soon}</span>
              </div>
            )}
          </div>

          <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-line pt-6">
            {p.data.github && (
              <a href={p.data.github} target="_blank" rel="noopener noreferrer" class="label-mono text-ink hover:text-accent transition-colors">
                GitHub ↗
              </a>
            )}
            {p.data.live && (
              <a href={p.data.live} target="_blank" rel="noopener noreferrer" class="label-mono text-ink hover:text-accent transition-colors">
                {s.live}
              </a>
            )}
            {p.data.note && <span class="text-sm text-muted">{loc(p.data, 'note', lang)}</span>}
          </div>
        </div>
      </dialog>
    ))
  }
</section>

<style>
  .project-card {
    transform-style: preserve-3d;
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s;
  }
  .spot {
    background: radial-gradient(320px circle at var(--mx, 50%) var(--my, 30%), rgba(255, 255, 255, 0.1), transparent 65%);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      (document.getElementById(btn.dataset.open!) as HTMLDialogElement | null)?.showModal();
    });
  });

  document.querySelectorAll<HTMLDialogElement>('dialog.project-dialog').forEach((d) => {
    d.addEventListener('click', (e) => {
      if (e.target === d) d.close();
    });
    d.addEventListener('close', () => d.querySelectorAll('video').forEach((v) => v.pause()));
  });

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer: fine)').matches;
  if (!reduce && fine) {
    document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        card.style.setProperty('--rx', `${(0.5 - py) * 5}deg`);
        card.style.setProperty('--ry', `${(px - 0.5) * 6}deg`);
        card.style.setProperty('--mx', `${px * 100}%`);
        card.style.setProperty('--my', `${py * 100}%`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });
  }
</script>
