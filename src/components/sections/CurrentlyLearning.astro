---
import { getCollection } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import { loc, t, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const s = t(lang).learning;

const tracks = (await getCollection('learning')).sort((a, b) => a.data.order - b.data.order);
---

<section id="learning" class="px-6 sm:px-10 py-28 lg:py-36 border-t border-line" aria-labelledby="learning-title">
  <div class="max-w-6xl mx-auto">
    <SectionHeading id="learning-title" eyebrow={s.eyebrow} title={s.title} intro={s.intro} />

    <div class="mt-16 grid gap-16 md:grid-cols-2">
      {
        tracks.map((track, ti) => {
          const items = track.data.items;
          const nowIndex = items.findIndex((i) => !i.done);
          return (
            <div>
              <h3 class="font-display font-light text-2xl text-ink reveal" style={`--rd: ${ti * 0.1}s`}>
                {loc(track.data, 'track', lang)}
              </h3>
              <ol class="mt-8">
                {items.map((item, i) => {
                  const isFirst = i === 0;
                  const isLast = i === items.length - 1;
                  const isNow = i === nowIndex;
                  return (
                    <li class="relative pl-11 py-3.5 reveal" style={`--rd: ${0.1 + i * 0.05}s`}>
                      <span
                        class:list={[
                          'absolute left-[11px] w-px',
                          item.done ? 'bg-accent/50' : 'bg-line',
                          isFirst ? 'top-1/2' : 'top-0',
                          isLast ? 'bottom-1/2' : 'bottom-0'
                        ]}
                        aria-hidden="true"
                      />
                      <span
                        class:list={[
                          'absolute left-0 top-1/2 -translate-y-1/2 flex h-6 w-6 items-center justify-center rounded-full border font-mono text-[11px] bg-bg',
                          item.done ? 'border-accent/60 text-accent' : isNow ? 'border-accent/40 text-ink' : 'border-line text-muted'
                        ]}
                        aria-hidden="true"
                      >
                        {item.done ? '✓' : '→'}
                      </span>
                      <span class:list={[item.done ? 'text-ink' : isNow ? 'text-ink' : 'text-muted']}>
                        {loc(item, 'name', lang)}
                      </span>
                      <span class="sr-only">{item.done ? s.srDone : isNow ? s.srNow : s.srNext}</span>
                      {isNow && <span class="ml-3 label-mono text-accent">{s.now}</span>}
                    </li>
                  );
                })}
              </ol>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
