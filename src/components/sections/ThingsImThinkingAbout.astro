---
import { getCollection } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import { homePath, loc, t, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const s = t(lang).thoughts;
const base = homePath(lang);

const thoughts = (await getCollection('thoughts')).sort((a, b) => a.data.order - b.data.order);
---

<section id="thoughts" class="px-6 sm:px-10 py-28 lg:py-36 border-t border-line" aria-labelledby="thoughts-title">
  <div class="max-w-6xl mx-auto">
    <SectionHeading id="thoughts-title" eyebrow={s.eyebrow} title={s.title} intro={s.intro} />

    <ul class="mt-14 grid gap-5 md:grid-cols-2">
      {
        thoughts.map((th, i) => (
          <li class="reveal" style={`--rd: ${i * 0.07}s`}>
            <a
              href={`${base}thoughts/${th.id}/`}
              class="glass group flex h-full flex-col justify-between rounded-3xl p-7 sm:p-8 transition-colors duration-300 hover:border-white/20 focus-visible:outline-2 focus-visible:outline-accent"
            >
              <span class="label-mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="mt-8 block font-display text-2xl sm:text-[1.7rem] font-light leading-snug text-ink">
                {loc(th.data, 'question', lang)}
              </span>
              <span class="mt-10 inline-flex items-center gap-2 label-mono transition-colors group-hover:text-ink">
                {th.body?.trim() ? s.read : s.soon}
                <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
