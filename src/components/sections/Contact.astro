---
import { contactLinks } from '../../data/contact';
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const s = t(lang).contact;

const links = contactLinks
  .filter((l) => l.href)
  .map((l) => ({ ...l, label: l.label === 'Email' ? s.email : l.label }));
---

<section id="contact" class="px-6 sm:px-10 py-32 lg:py-44 border-t border-line" aria-labelledby="contact-title">
  <div class="max-w-6xl mx-auto">
    <h2
      id="contact-title"
      class="font-display font-light leading-[1.02] text-ink text-[clamp(2.6rem,8.5vw,6.5rem)] reveal"
    >
      {s.line1}<br />
      <span class="text-muted">{s.line2}</span>
    </h2>

    <ul class="mt-16 flex flex-wrap gap-x-10 gap-y-4 reveal" style="--rd: 0.15s">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              target={l.href.startsWith('http') ? '_blank' : undefined}
              rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="group inline-flex items-center gap-2 label-mono text-ink hover:text-accent transition-colors duration-300"
            >
              {l.label}
              <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
