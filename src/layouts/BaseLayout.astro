---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { altPath, t, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** Only the English home page redirects French-preferring visitors to /fr/. */
  autoRedirect?: boolean;
}

const { lang = 'en', autoRedirect = false } = Astro.props;
const strings = t(lang);
const { title = strings.meta.title, description = strings.meta.description } = Astro.props;
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const redirectScript = `(function(){try{var s=localStorage.getItem('lang');var l=s||((navigator.language||'').toLowerCase().indexOf('fr')===0?'fr':'en');if(l==='fr'&&location.pathname==='/'){location.replace('/fr/'+location.search+location.hash);}}catch(e){}})();`;

// Canonical / absolute URLs are only emitted once `site` is set in astro.config.mjs (real domain).
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const hrefEn = site ? new URL(altPath(Astro.url.pathname, 'en'), site).href : undefined;
const hrefFr = site ? new URL(altPath(Astro.url.pathname, 'fr'), site).href : undefined;
const ogImage = site ? new URL('/images/og.jpg', site).href : '/images/og.jpg';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Charlize',
  description:
    lang === 'fr'
      ? "Construit ses connaissances en mathématiques, informatique, data et IA, et documente sa progression."
      : 'Building knowledge in mathematics, computer science, data and AI, and documenting the progression.',
  inLanguage: lang,
  knowsAbout: ['Mathematics', 'Linear algebra', 'Computer science', 'Data', 'Artificial intelligence'],
  sameAs: ['https://github.com/MiralAmana']
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {autoRedirect && <script is:inline set:html={redirectScript} />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Charlize" />
    <meta name="theme-color" content="#050506" />
    {canonical && <link rel="canonical" href={canonical} />}
    {hrefEn && <link rel="alternate" hreflang="en" href={hrefEn} />}
    {hrefFr && <link rel="alternate" hreflang="fr" href={hrefFr} />}
    {hrefEn && <link rel="alternate" hreflang="x-default" href={hrefEn} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:locale:alternate" content={other === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300;1,9..144,400&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-bg"
    >
      {strings.common.skip}
    </a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      const targets = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        targets.forEach((t) => io.observe(t));
      } else {
        targets.forEach((t) => t.classList.add('in'));
      }
    </script>
  </body>
</html>
