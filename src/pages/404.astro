---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui } from '../i18n/ui';
---

<BaseLayout title="404 — Charlize">
  <section class="min-h-[80svh] flex items-center px-6 sm:px-10 pt-32">
    <div class="max-w-3xl mx-auto w-full">
      <p class="label-mono">404</p>
      <h1 class="mt-6 font-display font-light text-5xl sm:text-7xl leading-[1.05] text-ink">
        {ui.en.notFound.title}<span class="text-accent">.</span>
      </h1>
      <p class="mt-4 font-display text-2xl font-light text-muted" lang="fr">{ui.fr.notFound.title}.</p>
      <div class="mt-10 flex flex-wrap gap-8">
        <a href="/" class="label-mono hover:text-ink transition-colors">{ui.en.notFound.back}</a>
        <a href="/fr/" lang="fr" class="label-mono hover:text-ink transition-colors">{ui.fr.notFound.back}</a>
      </div>
    </div>
  </section>
</BaseLayout>
